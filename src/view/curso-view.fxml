<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.java.edu.jett.colegio.gotitas.controller.CursoController">

    <BorderPane prefHeight="700.0"
                prefWidth="1100.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0">

        <top>
            <VBox spacing="5.0">
                <padding>
                    <Insets bottom="20.0"
                            left="30.0"
                            right="30.0"
                            top="25.0"/>
                </padding>

                <children>

                    <Label text="GESTIÓN DE CURSOS"
                           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

                    <Label text="Administra los cursos registrados en el Colegio Gotitas del Saber."
                           style="-fx-font-size: 14px;"/>

                </children>
            </VBox>
        </top>

        <center>
            <VBox spacing="20.0">

                <padding>
                    <Insets bottom="20.0"
                            left="30.0"
                            right="30.0"
                            top="10.0"/>
                </padding>

                <children>

                    <VBox spacing="12.0">

                        <children>

                            <HBox spacing="15.0">

                                <children>

                                    <VBox spacing="5.0"
                                          prefWidth="240.0">

                                        <children>

                                            <Label text="Nombre del curso"/>

                                            <TextField fx:id="txtNombre"
                                                       promptText="Ej. Matemática"/>

                                        </children>

                                    </VBox>

                                    <VBox spacing="5.0"
                                          prefWidth="280.0">

                                        <children>

                                            <Label text="Descripción"/>

                                            <TextField fx:id="txtDescripcion"
                                                       promptText="Descripción del curso"/>

                                        </children>

                                    </VBox>

                                    <VBox spacing="5.0"
                                          prefWidth="240.0">

                                        <children>

                                            <Label text="Docente"/>

                                            <TextField fx:id="txtDocente"
                                                       promptText="Nombre del docente"/>

                                        </children>

                                    </VBox>

                                    <VBox spacing="5.0"
                                          prefWidth="180.0">

                                        <children>

                                            <Label text="Grado"/>

                                            <TextField fx:id="txtGrado"
                                                       promptText="Ej. 4to"/>

                                        </children>

                                    </VBox>

                                </children>

                            </HBox>

                            <HBox spacing="10.0">

                                <children>

                                    <Button fx:id="btnGuardar"
                                            mnemonicParsing="false"
                                            onAction="#handleGuardar"
                                            text="Guardar"
                                            prefWidth="110.0"/>

                                    <Button fx:id="btnActualizar"
                                            mnemonicParsing="false"
                                            onAction="#handleActualizar"
                                            text="Actualizar"
                                            prefWidth="110.0"/>

                                    <Button fx:id="btnEliminar"
                                            mnemonicParsing="false"
                                            onAction="#handleEliminar"
                                            text="Eliminar"
                                            prefWidth="110.0"/>

                                    <Button fx:id="btnLimpiar"
                                            mnemonicParsing="false"
                                            onAction="#handleLimpiar"
                                            text="Limpiar"
                                            prefWidth="110.0"/>

                                </children>

                            </HBox>

                        </children>

                    </VBox>

                    <HBox spacing="10.0">

                        <children>

                            <Label text="Buscar curso:"
                                   style="-fx-font-weight: bold;"
                                   alignment="CENTER_LEFT"/>

                            <TextField fx:id="txtBuscar"
                                       promptText="Buscar por nombre, docente o grado"
                                       prefWidth="400.0"/>

                            <Button mnemonicParsing="false"
                                    onAction="#handleBuscar"
                                    text="Buscar"
                                    prefWidth="100.0"/>

                        </children>

                    </HBox>

                    <TableView fx:id="tablaCursos"
                               prefHeight="380.0"
                               prefWidth="1000.0"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="colId"
                                         prefWidth="60.0"
                                         text="ID"/>

                            <TableColumn fx:id="colNombre"
                                         prefWidth="190.0"
                                         text="Nombre"/>

                            <TableColumn fx:id="colDescripcion"
                                         prefWidth="280.0"
                                         text="Descripción"/>

                            <TableColumn fx:id="colDocente"
                                         prefWidth="220.0"
                                         text="Docente"/>

                            <TableColumn fx:id="colGrado"
                                         prefWidth="150.0"
                                         text="Grado"/>

                        </columns>

                    </TableView>

                    <HBox alignment="CENTER_RIGHT">

                        <children>

                            <Button mnemonicParsing="false"
                                    onAction="#handleRegresar"
                                    text="Regresar al menú"
                                    prefWidth="150.0"/>

                        </children>

                    </HBox>

                </children>

            </VBox>
        </center>

    </BorderPane>

</AnchorPane>