<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.java.edu.jett.colegio.gotitas.controller.EstudianteController"
            stylesheets="@estudiante-view.css">
    <BorderPane prefHeight="700.0"
                prefWidth="1150.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0">

        <top>
            <VBox spacing="5.0">
                <padding>
                    <Insets top="25.0"
                            right="30.0"
                            bottom="20.0"
                            left="30.0"/>
                </padding>

                <children>

                    <Label text="GESTIÓN DE ESTUDIANTES"
                           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

                    <Label text="Administra los estudiantes registrados en el Colegio Gotitas del Saber."
                           style="-fx-font-size: 14px;"/>

                </children>
            </VBox>
        </top>

        <center>
            <VBox spacing="18.0">

                <padding>
                    <Insets top="10.0"
                            right="30.0"
                            bottom="20.0"
                            left="30.0"/>
                </padding>

                <children>

                    <HBox spacing="15.0">

                        <children>

                            <VBox spacing="5.0" prefWidth="210.0">

                                <children>

                                    <Label text="Nombre"/>

                                    <TextField fx:id="txtNombre"
                                               promptText="Nombre del estudiante"/>

                                </children>

                            </VBox>

                            <VBox spacing="5.0" prefWidth="210.0">

                                <children>

                                    <Label text="Apellido"/>

                                    <TextField fx:id="txtApellido"
                                               promptText="Apellido del estudiante"/>

                                </children>

                            </VBox>

                            <VBox spacing="5.0" prefWidth="190.0">

                                <children>

                                    <Label text="Fecha de nacimiento"/>

                                    <TextField fx:id="txtFechaNacimiento"
                                               promptText="AAAA-MM-DD"/>

                                </children>

                            </VBox>

                            <VBox spacing="5.0" prefWidth="150.0">

                                <children>

                                    <Label text="Grado"/>

                                    <TextField fx:id="txtGrado"
                                               promptText="Ej. 4to"/>

                                </children>

                            </VBox>

                        </children>

                    </HBox>

                    <HBox spacing="15.0">

                        <children>

                            <VBox spacing="5.0" prefWidth="150.0">

                                <children>

                                    <Label text="Sección"/>

                                    <TextField fx:id="txtSeccion"
                                               promptText="Ej. A"/>

                                </children>

                            </VBox>

                            <VBox spacing="5.0" prefWidth="200.0">

                                <children>

                                    <Label text="Teléfono"/>

                                    <TextField fx:id="txtTelefono"
                                               promptText="Número de teléfono"/>

                                </children>

                            </VBox>

                        </children>

                    </HBox>

                    <HBox spacing="10.0">

                        <children>

                            <Button fx:id="btnGuardar"
                                    mnemonicParsing="false"
                                    onAction="#handleGuardar"
                                    text="Guardar"
                                    prefWidth="110.0"/>

                            <Button fx:id="btnActualizar"
                                    mnemonicParsing="false"
                                    onAction="#handleActualizar"
                                    text="Actualizar"
                                    prefWidth="110.0"/>

                            <Button fx:id="btnEliminar"
                                    mnemonicParsing="false"
                                    onAction="#handleEliminar"
                                    text="Eliminar"
                                    prefWidth="110.0"/>

                            <Button fx:id="btnLimpiar"
                                    mnemonicParsing="false"
                                    onAction="#handleLimpiar"
                                    text="Limpiar"
                                    prefWidth="110.0"/>

                        </children>

                    </HBox>

                    <HBox spacing="10.0">

                        <children>

                            <Label text="Buscar:"
                                   style="-fx-font-weight: bold;"/>

                            <TextField fx:id="txtBuscar"
                                       promptText="Nombre, apellido, grado o sección"
                                       prefWidth="400.0"/>

                            <Button mnemonicParsing="false"
                                    onAction="#handleBuscar"
                                    text="Buscar"
                                    prefWidth="100.0"/>

                        </children>

                    </HBox>

                    <TableView fx:id="tablaEstudiantes"
                               prefHeight="350.0"
                               prefWidth="1050.0"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="colId"
                                       prefWidth="55.0"
                                       text="ID"/>

                            <TableColumn fx:id="colNombre"
                                       prefWidth="160.0"
                                       text="Nombre"/>

                            <TableColumn fx:id="colApellido"
                                       prefWidth="160.0"
                                       text="Apellido"/>

                            <TableColumn fx:id="colFechaNacimiento"
                                       prefWidth="150.0"
                                       text="Nacimiento"/>

                            <TableColumn fx:id="colGrado"
                                       prefWidth="130.0"
                                       text="Grado"/>

                            <TableColumn fx:id="colSeccion"
                                       prefWidth="100.0"
                                       text="Sección"/>

                            <TableColumn fx:id="colTelefono"
                                       prefWidth="150.0"
                                       text="Teléfono"/>

                        </columns>

                    </TableView>

                    <HBox alignment="CENTER_RIGHT">

                        <children>

                            <Button mnemonicParsing="false"
                                    onAction="#handleRegresar"
                                    text="Regresar al menú"
                                    prefWidth="150.0"/>

                        </children>

                    </HBox>

                </children>

            </VBox>
        </center>

    </BorderPane>

</AnchorPane>