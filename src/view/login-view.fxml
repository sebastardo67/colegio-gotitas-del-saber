<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="main.java.edu.jett.colegio.gotitas.controller.LoginController" 
            stylesheets="@login-view.css" 
            prefHeight="650.0" prefWidth="1100.0">
    <children>
        <AnchorPane prefHeight="650.0" prefWidth="1100.0" styleClass="background">
            <children>
                <VBox alignment="CENTER" layoutX="570.0" layoutY="55.0" prefHeight="540.0" prefWidth="450.0" spacing="18.0" styleClass="login-card">
                    <children>
                        <Label text="G" styleClass="logo"/>
                        <Label text="Colegio Gotitas del Saber" styleClass="school-name"/>
                        <Label text="Bienvenido de nuevo" styleClass="title"/>
                        <Label text="Inicia sesión para continuar" styleClass="subtitle"/>
                        <VBox spacing="8.0" prefWidth="350.0">
                            <children>
                                <Label text="Correo electrónico" styleClass="field-label"/>
                                <TextField fx:id="txtFieldEmail" promptText="Ingresa tu correo electrónico" styleClass="input"/>
                            </children>
                        </VBox>
                        <VBox spacing="8.0" prefWidth="350.0">
                            <children>
                                <Label text="Contraseña" styleClass="field-label"/>
                                <PasswordField fx:id="txtFieldPassword" promptText="Ingresa tu contraseña" styleClass="input"/>
                            </children>
                        </VBox>
                        <Button text="INICIAR SESIÓN" onAction="#handleLogin" prefWidth="350.0" prefHeight="50.0" styleClass="login-button"/>
                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label text="¿No tienes una cuenta?" styleClass="register-text"/>
                                <Button text="Crear cuenta" onAction="#handleOpenRegister" styleClass="register-button"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox alignment="CENTER_LEFT" layoutX="75.0" layoutY="155.0" prefWidth="400.0" spacing="20.0">
                    <children>
                        <Label text="APRENDER" styleClass="side-small-title"/>
                        <Label text="CRECER" styleClass="side-title"/>
                        <Label text="Y BRILLAR." styleClass="side-title"/>
                        <Label text="Una comunidad educativa construida&#10;para acompañar cada paso de nuestros estudiantes." styleClass="side-description"/>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>