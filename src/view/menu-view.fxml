<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="main.java.edu.jett.colegio.gotitas.controller.MenuController"
    prefHeight="650.0"
    prefWidth="1100.0">

    <children>

        <AnchorPane
            prefHeight="650.0"
            prefWidth="1100.0"
            style="-fx-background-color: #f4f6f9;"
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">

            <children>

                <HBox
                    alignment="CENTER_LEFT"
                    layoutX="50.0"
                    layoutY="25.0"
                    prefWidth="1000.0"
                    spacing="20.0"
                    style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 10, 0, 0, 4);">

                    <padding>
                        <Insets
                            top="12.0"
                            right="25.0"
                            bottom="12.0"
                            left="25.0"/>
                    </padding>

                    <children>

                        <Label
                            text="🏫 Colegio Gotitas del Saber"
                            style="-fx-text-fill: #1f3c88; -fx-font-size: 22px; -fx-font-weight: bold;"/>

                        <Label
                            text="Panel Principal"
                            style="-fx-text-fill: #666666; -fx-font-size: 15px;"/>

                    </children>

                </HBox>

                <VBox
                    alignment="CENTER"
                    layoutX="300.0"
                    layoutY="150.0"
                    prefHeight="420.0"
                    prefWidth="500.0"
                    spacing="20.0"
                    style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 15, 0, 0, 5);">

                    <padding>
                        <Insets
                            top="30.0"
                            right="30.0"
                            bottom="30.0"
                            left="30.0"/>
                    </padding>

                    <children>

                        <Label
                            text="Menú Principal"
                            style="-fx-text-fill: #1f3c88; -fx-font-size: 28px; -fx-font-weight: bold;"/>

                        <Label
                            text="Seleccione una opción"
                            style="-fx-text-fill: #666666; -fx-font-size: 14px;"/>

                        <Button
                            fx:id="btnIrEstudiantes"
                            text="👨‍🎓 Gestión de Estudiantes"
                            prefWidth="300.0"
                            prefHeight="45.0"
                            onAction="#handleEstudiantes"
                            style="-fx-background-color: #1f3c88; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>

                        <Button
                            fx:id="btnIrDocentes"
                            text="👨‍🏫 Gestión de Docentes"
                            prefWidth="300.0"
                            prefHeight="45.0"
                            onAction="#handleDocentes"
                            style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>
                        
                        <Button
    fx:id="btnIrCursos"
    text="📚 Gestión de Cursos"
    prefWidth="300.0"
    prefHeight="45.0"
    onAction="#handleCursos"
                            style="-fx-background-color: #7b2cbf; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>
                   

                        <Button
                            fx:id="btnCerrarSesion"
                            text="🚪 Cerrar Sesión"
                            prefWidth="300.0"
                            prefHeight="45.0"
                            onAction="#handleCerrarSesion"
                            style="-fx-background-color: #c1121f; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>

                    </children>

                </VBox>

            </children>

        </AnchorPane>

    </children>

</AnchorPane>